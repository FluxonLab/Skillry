    "subagents",
    "skills",
    "ai-agents",
    "plugin-marketplace",
    "llm-tools",
    "developer-tools"
  ],
  "homepage": "https://github.com/FluxonLab/Skillry#readme",
  "bugs": {
    "url": "https://github.com/FluxonLab/Skillry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FluxonLab/Skillry.git"
  },
  "license": "MIT",
  "author": "FluxonLab — Çağrı Bozgeyik (https://cagribozgeyik.com)",
  "funding": "https://fluxonlab.com",
  "type": "commonjs",
  "bin": {
    "skillry": "bin/skillry.js"
  },
  "files": [
    "bin/",
    "tools/",
    "plugins/",
    "community/",
    ".claude-plugin/",
