{
  "name": "skillry",
  "version": "3.3.0",
  "description": "Installable, permission-bounded, multi-platform agent skills & subagents for Claude Code, OpenAI Codex, Cursor, GitHub Copilot, Google Antigravity (Gemini) and OpenCode.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "copilot",
    "antigravity",
    "gemini",
    "opencode",
    "agent",
    "agents",
    "subagents",
    "skills",
    "ai-agents",
    "plugin-marketplace",
    "llm-tools",
    "developer-tools"
  ],
  "homepage": "https://github.com/FluxonLab/Skillry#readme",
  "bugs": {
    "url": "https://github.com/FluxonLab/Skillry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FluxonLab/Skillry.git"
  },
  "license": "MIT",
  "author": "FluxonLab — Çağrı Bozgeyik (https://cagribozgeyik.com)",
  "funding": "https://fluxonlab.com",
  "type": "commonjs",
  "bin": {
    "skillry": "bin/skillry.js"
  },
  "files": [
    "bin/",
    "tools/build-lock.py",
    "tools/build-marketplace.py",
    "tools/install.py",
    "tools/jev.py",
    "tools/jev/__init__.py",
    "tools/jev/catalog.py",
    "tools/jev/cli.py",
    "tools/jev/core.py",
    "tools/jev/install.py",
    "tools/jev/operations.py",
    "tools/jev/provider.py",
    "tools/jev/requirements.txt",
    "tools/jev/requirements.in",
    "tools/storage.py",
    "tools/storage/",
    "tools/release-gate.py",
    "tools/skill-sync.py",
    "tools/validate.py",
    "plugins/",
    "community/",
    ".claude-plugin/",
    "registry/",
    "docs/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md",
    "!**/__pycache__/**",
    "!**/*.py[cod]"
  ],
  "scripts": {
    "validate": "python3 tools/validate.py",
    "release-check": "python3 tools/release-gate.py",
    "prepack": "python3 tools/release-gate.py",
    "skills:install": "python3 tools/install.py",
    "skills:lock": "python3 tools/build-lock.py"
  },
  "engines": {
    "node": ">=16"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
