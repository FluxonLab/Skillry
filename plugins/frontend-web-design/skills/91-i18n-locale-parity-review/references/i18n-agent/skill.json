    "Plan fr-CA + es localization",
    "Add CI checks for multilingual SEO"
  ],
  "tags": [
    "i18n",
    "l10n",
    "seo",
    "hreflang",
    "localization",
    "translation",
    "sitemaps",
    "bcp47",
    "astro",
    "nextjs",
    "nuxt"
  ],
  "required_tools": [
    "filesystem read/write",
